# 本地开发配置示例：复制为 .env 后填写模拟值，不得提交真实凭据。
MKTKB_DATA_DIR=var
MKTKB_CSRF_SECRET=replace-with-32-char-random-value
MKTKB_ADMIN_PASSWORD=replace-with-local-admin-password
MKTKB_EMPLOYEE_PASSWORD=replace-with-local-employee-password
# 受信任 Origin 支持三种写法（任选其一）：
#   单个：  http://127.0.0.1:8077
#   逗号：  http://127.0.0.1:8077,https://kb.example.com
#   JSON：  ["http://127.0.0.1:8077","https://kb.example.com"]
# 不接受 *、null、缺少 http(s) scheme/主机或带路径的来源。
MKTKB_TRUSTED_ORIGINS=http://127.0.0.1:8077
MKTKB_COOKIE_SECURE=false
MKTKB_SESSION_TTL_SECONDS=28800
MKTKB_LOG_LEVEL=INFO
# T03 可选运行参数（下列为默认值，按需覆盖）：
# 原件/暂存根目录；缺省为 <MKTKB_DATA_DIR>/storage，不作为公开静态目录。
# MKTKB_STORAGE_DIR=var/storage
# 单文件 20 MB 上限（20×1024×1024）与 Excel 跨可见表单文件 5000 条有效数据行上限。
# MKTKB_MAX_UPLOAD_BYTES=20971520
# MKTKB_EXCEL_MAX_DATA_ROWS=5000
# worker 领取租约 120 秒、每 30 秒续期。
# MKTKB_JOB_LEASE_SECONDS=120
# MKTKB_JOB_LEASE_RENEW_SECONDS=30
# OOXML 解压资源预算：成员数/解压总量/单成员/压缩比。
# MKTKB_OOXML_MAX_MEMBERS=2000
# MKTKB_OOXML_MAX_TOTAL_UNCOMPRESSED_BYTES=134217728
# MKTKB_OOXML_MAX_MEMBER_UNCOMPRESSED_BYTES=67108864
# MKTKB_OOXML_MAX_COMPRESSION_RATIO=100
# T06 服务端模型配置：三项必须同时提供才启用；缺任一项时问答返回 MODEL_NOT_CONFIGURED，
# 登录/资料/健康接口不受影响。示例密钥保持为空，真实密钥只放本机 .env，不提交、不下发浏览器。
# MKTKB_MODEL_BASE_URL=https://api.deepseek.com
# MKTKB_MODEL_NAME=deepseek-chat
# MKTKB_MODEL_API_KEY=
# 单次模型 HTTP 超时上限（秒，默认 30）；总体问答预算固定 60 秒，不由此变量放大。
# MKTKB_MODEL_REQUEST_TIMEOUT_SECONDS=30
# T07 腾讯云 OCR：SecretId/SecretKey 必须同时提供才启用；缺任一项时扫描页返回 OCR_NOT_CONFIGURED。
# 真实密钥只放本机 .env，不提交、不下发浏览器；示例保持为空。目的地址固定为官方域名。
# MKTKB_OCR_SECRET_ID=
# MKTKB_OCR_SECRET_KEY=
# MKTKB_OCR_REGION=ap-guangzhou
# MKTKB_OCR_ENDPOINT=https://ocr.tencentcloudapi.com
# MKTKB_OCR_REQUEST_TIMEOUT_SECONDS=30
# PDF/图片边界（产品上限）：PDF 50 页、图片 20,000,000 像素；页面渲染先缩放再解码。
# MKTKB_PDF_MAX_PAGES=50
# MKTKB_IMAGE_MAX_PIXELS=20000000
# MKTKB_PDF_RENDER_SCALE=2
# MKTKB_PDF_MAX_PAGE_PIXELS=20000000
# OCR 单块编码体积/分块数、429 有界退避与单 worker 频率（不超过 2 次/秒）。
# MKTKB_OCR_MAX_IMAGE_BYTES=4194304
# MKTKB_OCR_MAX_TILES=64
# MKTKB_OCR_MAX_ATTEMPTS=3
# MKTKB_OCR_RETRY_BASE_SECONDS=0.25
# MKTKB_OCR_RETRY_MAX_SINGLE_SECONDS=1
# MKTKB_OCR_RETRY_TOTAL_SECONDS=2
# MKTKB_OCR_MAX_REQUESTS_PER_SECOND=2
