+def _prepare_derive_case(
+    tool: Any,
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    evidence_status: str = "complete",
+) -> SimpleNamespace:
+    binding, document, plan, _inputs = _synthetic_binding(
+        tool, tmp_path / "doc", business_date="2026-10-28"
