+@asyncio_test
+async def test_generic_entry_fails_on_real_misbinding(tmp_path: Path) -> None:
+    cases = (_make_case("P01", RAG_QUESTION), _make_case("P03", LEGACY_QUESTION))
+    plan, now = _make_plan(cases)
+    config = load_p2_gate_config()
