+def _assert_no_restricted(text: str) -> None:
+    for forbidden in (
+        "D:\\mktkb-p2-holdout",
+        "C:\\Users",
+        "\\\\fileserver",
+        ".fernet",
+        "scenario.key",
+    ):
+        assert forbidden not in text, (forbidden, text[:400])
