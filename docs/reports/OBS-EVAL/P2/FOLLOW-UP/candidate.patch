+        # 反例 A：把绑定改回"产品资料发布版本"（修复前的老口径）——必须失败。
+        # 反例 B：任意错值 5 —— 也必须失败（不是只认某一个魔法数字）。
+        for wrong in (3, 5):
+            tampered = dict(manifest, index_revision=wrong)
+            tampered["binding"] = dict(manifest["binding"], index_revision=wrong)
+            hard = evaluate_p2_hard_gates(
