{
  "schema_version": "t207-import-recipe/v0.1",
  "matrix": "B0（fixtures/acceptance 的 D01–D10 + B0 版 V01–V07）",
  "source_set": "fixtures/acceptance/normal + fixtures/acceptance/variants",
  "product_paths": {
    "upload_new_document": "POST /api/v1/documents（multipart file=…；allow_same_name 缺省）",
    "upload_new_version": "POST /api/v1/documents/{document_id}/versions（multipart file=…，expected_active_version_id 可选）",
    "publish_version": "POST /api/v1/documents/{document_id}/versions/{version_id}/publish（JSON expected_active_version_id + expected_revision）",
    "process": "ingestion.worker.run_one_job(db, store, ocr=…, ocr_options={\"max_attempts\": 1}) —— 适配器在进程内驱动，不走 HTTP",
    "adapter_entry": "product_adapter.ProductEvalAdapter.ingest(P2IngestPlan) -> [IngestReceipt]（IngestSource.document_id / publish 已是既有入参）"
  },
  "gaps_in_current_driver": [
    "cli.py 的 p2-run 只有 --ingest <path>：构造 IngestSource(path=…) 时 document_id=None、publish=True，V03 与 D01 因此各自成为独立 active 文档（各 version=1）——这就是 T206 Q01 conflict 的原因",
    "没有表达「第 3 版不发布」的入口（IngestSource.publish=False 存在，但 CLI 传不进去）",
    "document_id 由第一次上传返回，静态参数没法预填（必须传符号引用，由 ingest() 回填）"
  ],
  "minimal_driver_delta": {
    "files": [
      "backend/src/mktkb/evaluation/product_adapter.py",
      "backend/src/mktkb/evaluation/cli.py"
    ],
    "shape": [
      "IngestSource 新增可选 document_ref: str | None，指向更早一条 source 的 name（链式同文档）",
      "ProductEvalAdapter.ingest()：每次上传成功后把 name -> document_id 记进本次 ingest 的本地表；遇到 document_ref 就解析成 document_id 走「新版本」上传",
      "cli.py p2-run 新增 --ingest-plan <json>（与 --ingest 互斥；--ingest 行为不变），json 里可写 document_ref 与 publish=false"
    ],
    "refuses": "引用未定义 / 自引用 / 引用尚未上传成功的 source -> 上传前拒绝（不建文档、不计费）"
  },
