+def _diag_number(spec: CaseSpec) -> int:
+    return int(spec.case_id.rsplit("-", 1)[1])
+
+
+def _diag_specs() -> tuple[CaseSpec, ...]:
+    """30 题（10-5-5-5-5）：期望 kind / should_refuse / 期望来源都写在题面上。"""
+    plan: list[tuple[int, str]] = []
+    for stratum, count in STRATA_PLAN:
+        plan.extend((number, stratum) for number in range(len(plan) + 1, len(plan) + count + 1))
+    specs: list[CaseSpec] = []
+    for number, stratum in plan:
+        refusal = stratum == "negative"
