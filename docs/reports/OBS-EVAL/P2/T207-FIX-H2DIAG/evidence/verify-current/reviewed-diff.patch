+def _diag_product(spec: CaseSpec) -> tuple[str, str, str | None, str]:
+    number = _diag_number(spec)
+    if number in _DIAG_PRODUCT:
+        return _DIAG_PRODUCT[number]
+    if spec.expected_kind == "refusal":
+        return "not_found", "", None, "active"
+    if spec.expected_kind == "conflict":
+        return "conflict", "两份资料不一致（合成）", None, "active"
+    return "answer", f"资料写着：{VALUE_TOKEN}", DIAG_UNIT_ID, "active"
