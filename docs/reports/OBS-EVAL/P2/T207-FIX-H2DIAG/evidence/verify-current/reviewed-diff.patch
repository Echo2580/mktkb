+            sources.append({"doc_code": "V06", "unit_key": DIAG_UNIT_KEY})
+        multi_turn = stratum == "multi_turn"
+        specs.append(
+            CaseSpec(
+                case_id=f"{DIAG_CASE_PREFIX}-{number:02d}",
+                suite="p2-holdout",
+                split="holdout",
+                stratum=stratum,
