+# --------------------------------------------------------------------------- #
+# T207-FIX-H2DIAG：H2 聚合诊断（只出稳定代码/计数；不出题干/答案/逐题）
+# --------------------------------------------------------------------------- #
+
+HOLDOUT_DIAGNOSTICS_SCHEMA_VERSION = "p2-holdout-diagnostics/v0.1"
+"""``holdout_scorecard.json`` 里 ``diagnostics`` 的 schema 版本（additive）。"""
+
+_HOLDOUT_DIAG_TOP_KEYS = frozenset(
+    {
+        "schema_version",
+        "detail_available",
+        "total",
+        "ends_observed",
+        "kind_matrix",
+        "refusal_matrix",
+        "failing_checks",
+        "source_mapping",
+        "errors_by_code",
+        "by_stratum",
+    }
+)
+"""诊断的**固定顶层键**：出现未登记键 = 结构变了，先审白名单（审计 fail-closed）。"""
+
+_HOLDOUT_DIAG_CODE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}$")
+"""诊断里允许的**稳定代码**形态：kind / check_id / doc_code / 错误码 / 占位码。
+
+不允许空白、CJK、括号等自由文本字符，长度 ≤64；题面/答案/引文几乎不可能命中，
+命中即按"自由文本"处理（``holdout_scorecard_leak``，fail-closed）。
+"""
+
+#: 诊断里"未执行/执行失败"的固定占位 kind：只进 ``kind_matrix``，不进拒答矩阵。
+_DIAG_KIND_NOT_EXECUTED = "not_executed"
+_DIAG_KIND_ERROR = "error"
+_DIAG_KIND_UNKNOWN = "unknown"
+_DIAG_NON_END_KINDS = frozenset(
+    {_DIAG_KIND_ERROR, _DIAG_KIND_UNKNOWN, _DIAG_KIND_NOT_EXECUTED, "service_error", "timeout"}
+)
+
+
+@dataclass(frozen=True)
+class _HoldoutScoring:
+    """H2 逐题判定的**内存上下文**：只服务诊断聚合，不落盘、不出 case_id。"""
+
+    rows: Mapping[str, Mapping[str, Any]] = field(default_factory=dict)
+    scores: Mapping[str, P2CaseScore] = field(default_factory=dict)
+    codes: Mapping[str, str] = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class _HoldoutDiagCase:
+    """一条题的**诊断维度**：全部是代码/计数/布尔，没有题干、答案、case_id。"""
+
+    stratum: str
+    expected_kind: str
+    actual_kind: str
+    should_refuse: bool
+    refused: bool
+    has_end: bool
+    failing_checks: tuple[str, ...]
+    error_code: str | None
+    doc_codes: frozenset[str]
+    source_failed_codes: frozenset[str]
+
+
+def _diag_code(value: Any, *, fallback: str) -> str:
+    """把任意值收成**稳定代码**；收不了就换固定占位（绝不把自由文本写进诊断）。"""
+    text = str(value or "").strip()
+    if text and _HOLDOUT_DIAG_CODE_RE.match(text):
+        return text
+    return fallback
+
+
+def _case_actual_kind(mark: P2HoldoutCaseScore, score: P2CaseScore | None) -> str:
+    """产品的**实际结局 kind**：取末轮 ``product.kind``；没有就是固定占位码。
+
+    末轮才是评分口径用的那一轮（多轮题中间轮的 kind 不参与判定）；行里没有 product
+    （执行失败/未执行）时按状态落到 ``error``/``not_executed``，不猜具体 kind。
+    """
+    if score is not None and score.turn_kinds:
+        actual = _diag_code(score.turn_kinds[-1], fallback="")
+        if actual:
+            return actual
+    if mark.status == CASE_STATUS_NOT_EXECUTED:
+        return _DIAG_KIND_NOT_EXECUTED
+    if mark.status == CASE_STATUS_ERROR:
+        return _DIAG_KIND_ERROR
+    return _DIAG_KIND_UNKNOWN
+
+
+def _case_error_code(
+    mark: P2HoldoutCaseScore,
+    row: Mapping[str, Any] | None,
+    score: P2CaseScore | None,
+) -> str | None:
+    """**首因**错误码：每题最多记一个（保证 ``sum(errors_by_code) == errors``）。
+
+    优先取逐题行/逐轮行上的 ``error_code``（真实失败码），其次取打分期的隔离问题码
+    （``source_not_active`` 这类结构问题），最后退到状态码；**只取代码**，不取 detail
+    （detail 里可能带 case_id）。
+    """
+    if mark.status not in {CASE_STATUS_ERROR, CASE_STATUS_NOT_EXECUTED}:
+        return None
+    if row is None:
+        return _DIAG_KIND_NOT_EXECUTED
+    code = str(row.get("error_code") or "").strip()
+    if not code:
+        for turn in row.get("turns") or ():
+            if isinstance(turn, Mapping) and turn.get("error_code"):
+                code = str(turn["error_code"]).strip()
+                break
+    if not code and score is not None:
+        for issue in score.issues:
+            candidate = str(getattr(issue, "code", "") or "").strip()
+            if candidate:
+                code = candidate
+                break
+    return _diag_code(code or mark.status, fallback=_DIAG_KIND_ERROR)
+
+
+def _case_failing_checks(score: P2CaseScore | None) -> tuple[str, ...]:
+    """该题**失败的 check_id**（稳定代码；只留 id，不带 evidence）。"""
+    if score is None:
+        return ()
+    failed: dict[str, None] = {}
+    for check in score.checks:
+        if not isinstance(check, Mapping):
+            continue
+        if str(check.get("status") or "") != "fail":
+            continue
+        failed.setdefault(_diag_code(check.get("check_id"), fallback="unknown_check"), None)
+    return tuple(failed)
+
+
+def _case_source_failed_codes(case: Any, score: P2CaseScore | None) -> frozenset[str]:
+    """该题**没命中的期望来源** doc_code（``source_hit`` 失败项按 ``missing_index`` 归位）。
+
+    归位不到（老格式/空 evidence）时退化成"该题期望的全部 doc_code"：只多算、不少算，
+    不会把失败记到没被期望的来源上。
+    """
+    expected = tuple(getattr(case, "expected_sources", ()) or ())
+    if not expected or score is None:
+        return frozenset()
+    failed: set[str] = set()
+    for check in score.checks:
+        if not isinstance(check, Mapping):
+            continue
+        if str(check.get("check_id") or "") != "source_hit":
+            continue
+        if str(check.get("status") or "") != "fail":
+            continue
+        evidence = check.get("evidence") if isinstance(check.get("evidence"), Mapping) else {}
+        missing = evidence.get("missing_index")
+        picked: set[str] = set()
+        if isinstance(missing, Sequence) and not isinstance(missing, (str, bytes)):
+            for index in missing:
+                if isinstance(index, bool) or not isinstance(index, int):
+                    continue
+                if not 0 <= index < len(expected):
+                    continue
+                ref = expected[index]
+                if not isinstance(ref, Mapping):
+                    continue
+                code = str(ref.get("doc_code") or "").strip()
+                if code:
+                    picked.add(code)
+        failed |= picked or set(_case_doc_codes(case))
+    return frozenset(failed)
+
+
+def _holdout_diag_cases(
+    cases: Sequence[Any],
+    marks: Sequence[P2HoldoutCaseScore],
+    scoring: _HoldoutScoring,
+) -> tuple[_HoldoutDiagCase, ...]:
+    """把逐题判定 + 内存明细折成诊断维度（仍只在内存里，不导出）。"""
+    by_id = {item.case_id: item for item in marks}
+    records: list[_HoldoutDiagCase] = []
+    for case in cases:
+        mark = by_id.get(case.case_id)
+        if mark is None:  # pragma: no cover - marks 与 cases 逐题对齐
+            continue
+        score = scoring.scores.get(case.case_id)
+        actual_kind = _case_actual_kind(mark, score)
+        records.append(
+            _HoldoutDiagCase(
+                stratum=str(case.stratum),
+                expected_kind=_diag_code(case.expected_kind, fallback=_DIAG_KIND_UNKNOWN),
+                actual_kind=actual_kind,
+                should_refuse=bool(case.should_refuse),
+                refused=is_refusal(actual_kind),
+                has_end=(
+                    mark.status != CASE_STATUS_NOT_EXECUTED
+                    and actual_kind not in _DIAG_NON_END_KINDS
+                ),
+                failing_checks=_case_failing_checks(score),
+                error_code=_case_error_code(mark, scoring.rows.get(case.case_id), score),
+                doc_codes=_case_doc_codes(case),
+                source_failed_codes=_case_source_failed_codes(case, score),
+            )
+        )
+    return tuple(records)
+
+
+def _diag_tally(records: Sequence[_HoldoutDiagCase]) -> dict[str, Any]:
+    """一组诊断维度 -> 四张计数表（键全部排好序，产物可直接比对）。"""
+    kinds: dict[str, dict[str, int]] = {}
+    refusal = {
+        "true": {"refused": 0, "not_refused": 0},
+        "false": {"refused": 0, "not_refused": 0},
+    }
+    failing: dict[str, int] = {}
+    errors: dict[str, int] = {}
+    for record in records:
+        bucket = kinds.setdefault(record.expected_kind, {})
+        bucket[record.actual_kind] = bucket.get(record.actual_kind, 0) + 1
+        if record.has_end:
+            row = refusal["true" if record.should_refuse else "false"]
+            row["refused" if record.refused else "not_refused"] += 1
+        for check_id in record.failing_checks:
+            failing[check_id] = failing.get(check_id, 0) + 1
+        if record.error_code:
+            errors[record.error_code] = errors.get(record.error_code, 0) + 1
+    return {
+        "kind_matrix": {
+            expected: dict(sorted(counts.items()))
+            for expected, counts in sorted(kinds.items())
+        },
+        "refusal_matrix": refusal,
+        "failing_checks": dict(sorted(failing.items())),
+        "errors_by_code": dict(sorted(errors.items())),
+    }
+
+
+def _source_mapping(
+    records: Sequence[_HoldoutDiagCase], codes: Mapping[str, str]
+) -> dict[str, Any]:
+    """期望来源 doc_code 的映射统计：可用/期望/缺失代码数 + 每代码的期望与未命中题数。
+
+    ``mapped`` 与 ``holdout_document_code_unmapped`` block 的 evidence 同口径
+    （``mapped`` = 语料能提供的代号个数）；``expected_cases_mapped`` 只统计**全部**期望
+    代号都能映射到的题，缺一个也算未映射（不猜、不放行）。
+    """
+    available = {
+        _diag_code(value, fallback="") for value in (codes or {}).values()
+    } - {""}
+    by_doc_code: dict[str, dict[str, Any]] = {}
+    expected_cases = 0
+    expected_mapped = 0
+    failed_cases = 0
+    for record in records:
+        if not record.doc_codes:
+            continue
+        expected_cases += 1
+        if record.doc_codes <= available:
+            expected_mapped += 1
+        if record.source_failed_codes:
+            failed_cases += 1
+        for code in sorted(record.doc_codes):
+            name = _diag_code(code, fallback="unknown")
+            slot = by_doc_code.setdefault(
+                name, {"expected_cases": 0, "source_hit_failed": 0, "mapped": name in available}
+            )
+            slot["expected_cases"] += 1
+            if code in record.source_failed_codes:
+                slot["source_hit_failed"] += 1
+    missing = [name for name, slot in by_doc_code.items() if not slot["mapped"]]
+    return {
+        "doc_codes_available": len(available),
+        "doc_codes_expected": len(by_doc_code),
+        "doc_codes_missing": len(missing),
+        "expected_cases": expected_cases,
+        "expected_cases_mapped": expected_mapped,
+        "source_hit_failed_cases": failed_cases,
+        "by_doc_code": {name: by_doc_code[name] for name in sorted(by_doc_code)},
+    }
+
+
+def _holdout_diagnostics(
+    cases: Sequence[Any],
+    marks: Sequence[P2HoldoutCaseScore],
+    scoring: _HoldoutScoring,
+) -> dict[str, Any]:
+    """H2 聚合诊断（additive）：kind 矩阵 / 拒答矩阵 / 失败 check / 来源映射 / 错误码。
+
+    只有稳定代码、计数与布尔；没有题干、答案、reference_answer、case_id、locator，
+    也没有逐题行。明细不可得时（``detail_available=false``）只按状态归类，不编造分布。
+    """
+    records = _holdout_diag_cases(cases, marks, scoring)
+    payload: dict[str, Any] = {
+        "schema_version": HOLDOUT_DIAGNOSTICS_SCHEMA_VERSION,
+        "detail_available": all(case.case_id in scoring.scores for case in cases),
+        "total": len(records),
+        "ends_observed": sum(1 for record in records if record.has_end),
+    }
+    payload.update(_diag_tally(records))
+    payload["source_mapping"] = _source_mapping(records, scoring.codes)
+    payload["by_stratum"] = {
+        stratum: _diag_tally([record for record in records if record.stratum == stratum])
+        for stratum in sorted({record.stratum for record in records})
+    }
+    return payload
+
+
+def _assert_holdout_diagnostics(payload: Any) -> None:
+    """诊断结构的**白名单审计**：固定顶层键 + 稳定代码/布尔/整数，命中自由文本即 fail-closed。
+
+    递归只允许 ``Mapping`` / ``str`` / ``int`` / ``bool``：数组一律拒绝（数组是夹带
+    自由文本最方便的形状）。嵌套键先按代码形态校验，再逐层下钻；``schema_version`` 只认本包常量。
+    """
+    if payload is None:
+        return
+    if not isinstance(payload, Mapping):
+        raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断不是对象")
+
+    def _walk(node: Any, *, top: bool) -> None:
+        if isinstance(node, Mapping):
+            for key, value in node.items():
+                name = str(key)
+                if top:
+                    if name not in _HOLDOUT_DIAG_TOP_KEYS:
+                        raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断含未登记字段")
+                elif not _HOLDOUT_DIAG_CODE_RE.match(name):
+                    raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断的键不是稳定代码")
+                if name.startswith("H2-"):
+                    raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断含 H2 case_id")
+                if name == "schema_version":
+                    if str(value) != HOLDOUT_DIAGNOSTICS_SCHEMA_VERSION:
+                        raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断版本不是固定值")
+                    continue
+                _walk(value, top=False)
+            return
+        if isinstance(node, bool) or isinstance(node, int):
+            return
+        if isinstance(node, str):
+            if not _HOLDOUT_DIAG_CODE_RE.match(node):
+                raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断的值不是稳定代码")
+            if node.startswith("H2-"):
+                raise P2RunError(ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断含 H2 case_id")
+            return
+        raise P2RunError(
+            ERROR_HOLDOUT_SCORECARD_LEAK, "聚合诊断只允许固定键/稳定代码/计数/布尔"
+        )
+
+    _walk(payload, top=True)
 
 
