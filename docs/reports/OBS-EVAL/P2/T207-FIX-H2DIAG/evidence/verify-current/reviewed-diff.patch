+def _diag_rows(specs: tuple[CaseSpec, ...]) -> dict[str, dict[str, Any]]:
+    """逐题行（只在内存里）：10 号故意**没有**行（未执行）；15 号第 2 轮 error。"""
+    rows: dict[str, dict[str, Any]] = {}
+    for spec in specs:
+        number = _diag_number(spec)
+        if number == 10:
+            continue
+        questions = _turn_questions(spec)
+        if number == 15:
+            rows[spec.case_id] = {
+                "case_id": spec.case_id,
+                "status": "error",
+                "error_code": "MODEL_OUTPUT_INVALID",
+                "planned_turns": len(questions),
+                "turns": [
+                    {
+                        "turn": 1,
+                        "status": "ok",
+                        "error_code": None,
+                        "product": _product_turn(
+                            questions[0], text=f"资料写着：{VALUE_TOKEN}"
+                        ).as_dict(include_text=True),
+                    },
+                    {
+                        "turn": 2,
+                        "status": "error",
+                        "error_code": "MODEL_OUTPUT_INVALID",
+                        "product": None,
+                    },
+                ],
+            }
+            continue
+        kind, text, unit_id, status = _diag_product(spec)
+        unit_key = DIAG_WRONG_UNIT_KEY if unit_id == DIAG_WRONG_UNIT_ID else DIAG_UNIT_KEY
+        rows[spec.case_id] = {
+            "case_id": spec.case_id,
+            "status": "ok",
+            "error_code": None,
+            "planned_turns": len(questions),
+            "turns": [
+                {
+                    "turn": index,
+                    "status": "ok",
+                    "error_code": None,
+                    "product": _product_turn(
+                        question,
+                        kind=kind,
+                        text=text,
+                        source_id=unit_id,
+                        unit_key=unit_key,
+                        status=status,
+                    ).as_dict(include_text=True),
+                }
+                for index, question in enumerate(questions, start=1)
