+def _short_image_reference(text: str, start: int) -> bool:
+    """图名是否在子句内以短修饰出现（自成短语），而不是"资料名 + 图名"的复合名词尾词。"""
+    index = start
+    while index > 0 and text[index - 1] not in _IMAGE_CLAUSE_BREAKS:
+        index -= 1
+    return start - index <= _IMAGE_MODIFIER_CHARS
+
