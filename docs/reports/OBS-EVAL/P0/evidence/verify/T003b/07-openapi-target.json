       "employee"
      ],
      "title": "Role",
      "type": "string"
     }
    },
    "required": [
     "id",
     "display_name",
     "role"
    ],
    "title": "UserPublic",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   },
   "VersionSummary": {
    "properties": {
     "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
     },
     "number": {
      "title": "Number",
      "type": "integer"
     },
     "processing_report": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Processing Report"
     },
     "published_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Published At"
     },
     "sha256": {
      "title": "Sha256",
      "type": "string"
     },
     "state": {
      "enum": [
       "queued",
       "processing",
       "review_required",
       "failed",
       "published",
       "superseded",
       "cancelled",
       "deleted"
      ],
      "title": "State",
      "type": "string"
     },
     "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
     }
    },
    "required": [
     "id",
     "number",
     "state",
     "sha256",
     "uploaded_at"
    ],
    "title": "VersionSummary",
    "type": "object"
   }
  }
 },
